{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naif-mutfak",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Admin is protected by Cloudflare Access on the custom domain; never expose *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "naif-mutfak" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naif-mutfak-db",
      // Replace with the id from `wrangler d1 create naif-mutfak-db` before the first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_PUBLIC", "bucket_name": "naif-mutfak-media" },
    { "binding": "EBOOKS_PRIVATE", "bucket_name": "naif-mutfak-ebooks" }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:3000",
    "MEDIA_PUBLIC_URL": "http://localhost:3000/media",
    "PAYMENT_PROVIDER": "lemonsqueezy"
  },
  "observability": { "enabled": true }
}
