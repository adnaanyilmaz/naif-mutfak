{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naif-mutfak",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Admin is protected by Cloudflare Access on the custom domain; never expose *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "naif-mutfak" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naif-mutfak-db",
      // Replace with the id from `wrangler d1 create naif-mutfak-db` before the first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA_PUBLIC", "bucket_name": "naif-mutfak-media" },
    { "binding": "EBOOKS_PRIVATE", "bucket_name": "naif-mutfak-ebooks" }
  ],
  // Workers Rate Limiting (payments.md): checkout keyed on a hashed client IP, downloads on the order id.
  // Workers AI (admin auto-translation, admin.md §2). Free allocation: 10,000 Neurons/day.
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHECKOUT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DOWNLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "SITE_URL": "http://localhost:3000",
    "MEDIA_PUBLIC_URL": "http://localhost:3000/media",
    "PAYMENT_PROVIDER": "lemonsqueezy",
    // R2 bucket names for presigned S3 PUTs (must match r2_buckets above).
    "R2_MEDIA_BUCKET": "naif-mutfak-media",
    "R2_EBOOKS_BUCKET": "naif-mutfak-ebooks",
    // Admin auto-translation models (free-plan Workers AI models; swap here without code changes).
    "AI_TRANSLATE_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_REVIEW_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": { "enabled": true }
}
